                    <form method="POST" action="{{ route('admin.reports.dismiss', $report) }}" style="margin-bottom: 1rem;">
                        @csrf
                        <div style="margin-bottom: 1rem;">
                            <label style="color: var(--text-light); font-weight: 700; text-transform: uppercase; font-size: 0.75rem; display: block; margin-bottom: 0.5rem;">Reason (Optional)</label>
                            <textarea name="admin_notes" placeholder="Why is this report being dismissed?" style="width: 100%; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(46, 204, 113, 0.2); color: var(--text-light); padding: 0.6rem; border-radius: 0.4rem; font-size: 0.9rem; min-height: 80px; resize: vertical;"></textarea>
                        </div>

                        <button type="submit" class="btn" style="width: 100%; background: rgba(127, 140, 141, 0.3); color: #95a5a6; font-weight: 700; padding: 0.8rem 1rem; border: 1px solid rgba(127, 140, 141, 0.2); border-radius: 0.6rem; cursor: pointer;">
                            <i class="fas fa-times-circle me-2"></i>Dismiss Report
                        </button>
                    </form>
                @endif

                <!-- Status Badge -->
                <div style="background: rgba(46, 204, 113, 0.1); padding: 1rem; border-radius: 0.6rem; border-left: 3px solid var(--light-green);">
                    <p style="color: #a4b8b5; margin: 0; font-size: 0.85rem; text-transform: uppercase; font-weight: 700;">Current Status</p>
                    <p style="color: var(--light-green); margin: 0.5rem 0 0 0; font-weight: 600;">
                        @php
                            $statusColor = match($report->status) {
                                'pending' => '#f39c12',
                                'under_review' => '#3498db',
                                'resolved' => '#27ae60',
                                'dismissed' => '#7f8c8d',
                                default => '#95a5a6'
                            };
                        @endphp
                        <i class="fas" style="color: {{ $statusColor }};" @class([
                            'fa-hourglass-half' => $report->status === 'pending',
                            'fa-magnifying-glass' => $report->status === 'under_review',
                            'fa-check-circle' => $report->status === 'resolved',
                            'fa-trash' => $report->status === 'dismissed',
                        ])></i>
                        {{ ucfirst(str_replace('_', ' ', $report->status)) }}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
